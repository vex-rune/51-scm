# ============================
# PlatformIO 构建产物（必须）
# ============================
.pio/

# 固件文件（按需提交）
*.hex
*.bin
*.elf

# 编译中间文件
*.rel
*.lst
*.lnp
*.map
*.mem
*.sym
*.lk
*.asm
*.cdb
*.reg
*.scat
*.lnk
*.rst
idedata.json

# 编译命令数据库（每次 pio run 自动生成，clangd 使用）
compile_commands.json

# ============================
# VSCode 本地配置（不提交）
# ============================
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/serialMonitorData.json

# ============================
# OS 临时文件
# ============================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ============================
# Python 字节码
# ============================
__pycache__/
*.pyc
*.pyo
