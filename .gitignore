# ============================
# 构建产物
# ============================

# PlatformIO 构建输出
.pio/
build/

# 固件文件（按需保留，按需提交）
*.hex
*.bin
*.elf

# SDCC/Keil 编译中间文件
*.rel
*.lst
*.lnp
*.map
*.mem
*.sym
*.lk
*.asm
*.cdb
*.reg
*.scat
*.lnk
*.rst
idedata.json

# 编译命令数据库（PlatformIO 自动生成，clangd 使用）
compile_commands.json

# ============================
# IDE 配置（各自环境不同）
# ============================

# JetBrains 系列
.idea/
.vscode/

# VSCode 工作区文件（多工程入口）
*.code-workspace

# VSCode 自动生成文件（含本地路径，不应提交）
.vscode/launch.json
.vscode/c_cpp_properties.json

# Trae IDE 内部缓存
.trae/skills/shared/__pycache__/

# ============================
# 工具链本地安装
# ============================
.toolchain/
.tools/

# ============================
# OS 临时文件
# ============================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ============================
# Python 字节码
# ============================
__pycache__/
*.pyc
*.pyo
*.pyd
